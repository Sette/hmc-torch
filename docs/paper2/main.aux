\@writefile{toc}{\contentsline {section}{\numberline {4}When Does the R-Matrix Help? Scaling Laws for HMC}{5}{section.4}\protected@file@percent }
\newlabel{sec:scaling}{{4}{5}{When Does the R-Matrix Help? Scaling Laws for HMC}{section.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Motivation}{5}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Variables}{5}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Results}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaling laws for HMC across 26 datasets. \textbf  {(a)} Micro-F1 vs.\ number of classes $C$ (log scale). Text datasets (green circles) maintain higher performance, but all modalities degrade with $C$. \textbf  {(b)} Micro-F1 vs.\ hierarchy depth $D$. Deeper hierarchies are harder: F1 drops from $\sim $0.75 at $D{=}2$ to $\sim $0.25 at $D{=}6$ and $\sim $0.40 at $D{=}12$ (GO DAGs). \textbf  {(c)} Training time vs.\ problem size $C \times N$, following a power law $t \propto (C{\times }N)^{0.85}$. \textbf  {(d)} Histogram of data-per-class ratio $N/C$ by modality.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:scaling}{{2}{6}{Scaling laws for HMC across 26 datasets. \textbf {(a)} Micro-F1 vs.\^^Mnumber of classes $C$ (log scale). Text datasets (green circles) maintain higher performance, but all modalities degrade with $C$. \textbf {(b)} Micro-F1 vs.\ hierarchy depth $D$. Deeper hierarchies are harder: F1 drops from $\sim $0.75 at $D{=}2$ to $\sim $0.25 at $D{=}6$ and $\sim $0.40 at $D{=}12$ (GO DAGs). \textbf {(c)} Training time vs.\ problem size $C \times N$, following a power law $t \propto (C{\times }N)^{0.85}$. \textbf {(d)} Histogram of data-per-class ratio $N/C$ by modality}{figure.caption.4}{}}
